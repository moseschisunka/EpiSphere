# EpiSphere Environment Variables Template
# Copy this file to .env and replace the values with your actual configuration.

# ---------------------------------------------------------
# BACKEND CONFIGURATION
# ---------------------------------------------------------
# The secret key is used for JWT signing and hashing.
# Generate a strong key in production (e.g., using `openssl rand -hex 32`)
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_TOKEN_EXPIRE_MINUTES=30
MFA_CHALLENGE_EXPIRE_MINUTES=5
EMAIL_VERIFICATION_REQUIRED=false
MFA_REQUIRED_FOR_PRIVILEGED=false

# Environment (development, staging, production)
ENVIRONMENT=development

# Database connection string
# Examples:
#   PostgreSQL: postgresql://postgres:password@localhost:5432/episphere
#   SQLite: sqlite:///./episphere.db
DATABASE_URL=postgresql://episphere:episphere_password@postgres:5432/episphere_db

# ---------------------------------------------------------
# FRONTEND CONFIGURATION
# ---------------------------------------------------------
# Next.js API Base URL (must be set on the client)
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# API key for n8n autonomous agent requests. Leave empty to disable agent access.
# Legacy shared agent key; prefer the separately revocable scoped keys below.
AGENT_API_KEY=
NEWS_AGENT_API_KEY=
DATASET_AGENT_API_KEY=
# Persistent n8n credential encryption key.
N8N_ENCRYPTION_KEY=
PUBLIC_DATASET_ALLOWED_HOSTS=ghoapi.azureedge.net,raw.githubusercontent.com,www.who.int
PUBLIC_DATASET_MAX_ROWS=100000
PUBLIC_DATASET_MAX_REDIRECTS=3
PUBLIC_DISCLOSURE_THRESHOLD=5
SECURITY_TOKEN_RETENTION_DAYS=1
NOTIFICATION_RETENTION_DAYS=180

# ---------------------------------------------------------
# EXTERNAL INTEGRATIONS (Optional)
# ---------------------------------------------------------
# SMTP is required in production for verification, reset, and alert emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@episphere.ai

# DHIS2 Configuration
DHIS2_URL=https://play.dhis2.org/demo
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district
